---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// --- DADOS GLOBAIS ---
const cidade = "Divinésia";
const estado = "MG";
const whatsapp = "553298408646";
const telefone = "(32) 9 9840-8646";
const telefoneLink = "553298408646";

// --- DADOS CORRIGIDOS E PREENCHIDOS ---
const emailContato = "ramundo@divcomp.com";
const formsubmitAction = `https://formsubmit.co/${emailContato}`;
const instagramLink = "https://www.instagram.com/divcomp";
const facebookLink = "https://www.facebook.com/divcomp";
// ATENÇÃO: Preencha este link com o ID do seu Perfil da Empresa no Google.
const urlAvaliarGoogle = "https://g.page/r/YOUR_PLACE_ID/review";

const avaliacoes = [
    {
        nome: "Maria Korsgaard",
        foto: "/images/cliente1.jpg", // ✅ Você precisa adicionar esta imagem na pasta public/images
        data: "2023-03-15",
        texto: "O atendimento foi impecável! Recomendo demais, resolveram meu problema e deram total atenção.",
        estrelas: 5
    },
    {
        nome: "Maren Calzoni",
        foto: "/images/cliente2.jpg", // ✅ Você precisa adicionar esta imagem na pasta public/images
        data: "2023-03-12",
        texto: "Serviço rápido, muito profissional. Explicou tudo com paciência. Empresa confiável.",
        estrelas: 5
    },
    {
        nome: "Davis Dokidis",
        foto: "/images/cliente3.jpg", // ✅ Você precisa adicionar esta imagem na pasta public/images
        data: "2023-03-08",
        texto: "Fiz curso e também usei o suporte. Nota máxima. Recomendo a todos da região!",
        estrelas: 5
    },
    {
        nome: "Ana Silva",
        foto: "/images/cliente4.jpg", // ✅ Você precisa adicionar esta imagem na pasta public/images
        data: "2024-01-20",
        texto: "Profissionalismo e conhecimento técnico definem o serviço. A consultoria em redes foi essencial para minha empresa.",
        estrelas: 5
    },
];
---

<html lang="pt-BR" class="scroll-smooth">
<head>
    <BaseHead
            title="DivComp Soluções | Especialista em TI, Cursos e Manutenção"
            description="Leadpage oficial da DivComp Soluções: manutenção de computadores, TI, cursos, recuperação de dados e avaliações reais. Atendimento em Divinésia/MG e região."
    />
    <style is:inline>
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
    </style>
</head>
<body class="bg-white text-gray-900 font-sans antialiased">
<Header/>

<main>
    {/* Seções Hero, Contato Rápido e Serviços (sem alterações) */}
    <section class="relative w-full bg-white py-20 md:py-28 scroll-mt-24">
        <div class="absolute inset-0 -z-10 overflow-hidden">
            <svg class="absolute left-[50%] top-0 h-[100%] w-[100%] -translate-x-1/2" viewBox="0 0 1024 1024" aria-hidden="true">
                <circle cx="512" cy="512" r="512" fill="url(#gradient-radial-hero)" fill-opacity="0.2"></circle>
                <defs>
                    <radialGradient id="gradient-radial-hero">
                        <stop stop-color="#4ade80"></stop>
                        <stop offset="1" stop-color="#065f46"></stop>
                    </radialGradient>
                </defs>
            </svg>
        </div>
        <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-6 px-6">
			<span class="block text-base md:text-lg font-semibold text-green-700">
				Suporte Técnico e Treinamentos
			</span>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-balance bg-gradient-to-r from-green-600 to-emerald-800 bg-clip-text text-transparent">
                +20 Anos de Experiência Real em TI
            </h1>
            <p class="text-lg md:text-xl text-gray-700 mt-2 max-w-2xl">
                Soluções definitivas para seu computador, rede e tecnologia. Fale com quem realmente entende do assunto e resolve seu problema.
            </p>
        </div>
    </section>
    <section class="relative z-10">
        <div class="max-w-4xl mx-auto px-6 -mt-16">
            <div class="bg-white rounded-2xl shadow-xl border border-green-100/80 p-6 md:p-8">
                <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-6 md:gap-4">
                    <div class="md:col-span-2 flex justify-center">
                        <span class="icon-[mdi--face-agent] text-7xl text-green-600"></span>
                    </div>
                    <div class="md:col-span-6 text-center md:text-left">
                        <h3 class="text-xl md:text-2xl font-bold text-gray-800">Precisa de uma solução rápida?</h3>
                        <p class="text-gray-600 mt-1">Sem robôs ou menus complicados. Fale diretamente com um especialista.</p>
                    </div>
                    <div class="md:col-span-4 flex justify-center md:justify-end">
                        <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener" class="inline-flex items-center gap-3 bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-3 rounded-lg shadow-lg transition-transform hover:scale-105 w-full md:w-auto justify-center">
                            <span class="icon-[mdi--whatsapp] w-6 h-6"></span>
                            <span>{telefone}</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="servicos" class="w-full py-16 md:py-24 bg-slate-50 border-b border-green-100">
        <div class="max-w-5xl mx-auto px-6 md:px-10">
            <h2 class="text-center text-base/7 font-semibold text-green-600">Nossos Serviços</h2>
            <p class="mx-auto mt-2 max-w-2xl text-center text-4xl font-semibold tracking-tight text-balance text-gray-900 sm:text-5xl">
                Soluções completas para suas necessidades de tecnologia
            </p>
            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white rounded-xl shadow p-8 flex flex-col items-center gap-3 border border-green-100 text-center">
                    <span class="icon-[mdi--monitor] text-4xl text-green-600 mb-3"></span>
                    <h3 class="text-xl font-semibold text-gray-900">Manutenção de Computadores</h3>
                    <p class="text-gray-700">Formatar, limpar, otimizar, instalar e recuperar dados de notebook e PC.</p>
                </div>
                <div class="bg-white rounded-xl shadow p-8 flex flex-col items-center gap-3 border border-green-100 text-center">
                    <span class="icon-[mdi--server] text-4xl text-green-700 mb-3"></span>
                    <h3 class="text-xl font-semibold text-gray-900">TI Empresarial</h3>
                    <p class="text-gray-700">Redes, servidores, backup, internet, impressoras e suporte para seu negócio.</p>
                </div>
                <div class="bg-white rounded-xl shadow p-8 flex flex-col items-center gap-3 border border-green-100 text-center">
                    <span class="icon-[ph--chalkboard-teacher-bold] text-4xl text-green-700 mb-3"></span>
                    <h3 class="text-xl font-semibold text-gray-900">Cursos e Aulas</h3>
                    <p class="text-gray-700">Aulas de informática, Office e tecnologia. Capacitação para todas as idades.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="servicos-completos" class="bg-gradient-to-br from-blue-800 to-purple-700 py-20 text-white">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-6">Soluções Completas para Seu Celular</h2>
            <p class="text-lg md:text-xl mb-12 text-gray-200">
                Recuperamos dados, desbloqueamos celulares, reparamos sistemas e muito mais — tudo no mesmo lugar.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--file-restore-outline] text-5xl text-yellow-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Recuperação de Dados</h3>
                    <p class="mt-2 text-gray-200">Fotos, contatos e WhatsApp de aparelhos danificados ou formatados.</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--lock-open-variant-outline] text-5xl text-pink-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Desbloqueio de Tela</h3>
                    <p class="mt-2 text-gray-200">Remove passcodes, Apple ID, FRP, SIM lock e mais.</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--cog-sync-outline] text-5xl text-cyan-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Reparo de Sistema</h3>
                    <p class="mt-2 text-gray-200">Corrige boot loop, tela preta/branca e falhas do sistema.</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--whatsapp] text-5xl text-green-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Backup e Transferência</h3>
                    <p class="mt-2 text-gray-200">WhatsApp, arquivos e dados entre aparelhos com segurança.</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--delete-forever] text-5xl text-red-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Limpeza Segura (Eraser)</h3>
                    <p class="mt-2 text-gray-200">Apague tudo do aparelho com segurança (ideal para revenda).</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--map-marker-radius] text-5xl text-indigo-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Localização Virtual</h3>
                    <p class="mt-2 text-gray-200">Altere o GPS de seu dispositivo com precisão.</p>
                </div>
            </div>
            <a href={`https://wa.me/${whatsapp}`} target="_blank"
               class="mt-12 inline-flex items-center gap-3 bg-white text-blue-800 font-bold px-8 py-4 rounded-full shadow-lg hover:bg-gray-100 transition">
                <span class="icon-[mdi--whatsapp] text-2xl"></span>
                Solicitar Atendimento Agora
            </a>
        </div>
    </section>

    <section id="servicos-pc" class="bg-gradient-to-br from-purple-700 via-blue-800 to-indigo-900 py-20 text-white">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-6">Serviços para Computadores e Notebooks</h2>
            <p class="text-lg md:text-xl mb-12 text-gray-200">
                Recuperação de arquivos apagados, reparação de sistema e muito mais.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--file-restore-outline] text-5xl text-yellow-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Recuperação de Arquivos</h3>
                    <p class="mt-2 text-gray-200">Recupere fotos, vídeos, documentos e dados apagados ou perdidos em HD, SSD, pen drive ou cartão SD.</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--harddisk] text-5xl text-green-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Recuperação de HD Formatado</h3>
                    <p class="mt-2 text-gray-200">Mesmo após formatação acidental, conseguimos resgatar dados com segurança.</p>
                </div>
                <div class="bg-white/10 rounded-2xl p-8 shadow-lg hover:scale-105 transition">
                    <span class="icon-[mdi--monitor-screenshot] text-5xl text-pink-300 mb-4"></span>
                    <h3 class="text-xl font-bold">Reparo de Sistema</h3>
                    <p class="mt-2 text-gray-200">Corrija erros de inicialização do Windows, tela azul e sistemas que não ligam.</p>
                </div>
            </div>
            <a href={`https://wa.me/${whatsapp}`} target="_blank"
               class="mt-12 inline-flex items-center gap-3 bg-white text-purple-800 font-bold px-8 py-4 rounded-full shadow-lg hover:bg-gray-100 transition">
                <span class="icon-[mdi--whatsapp] text-2xl"></span>
                Solicitar Atendimento Agora
            </a>
        </div>
    </section>

    


    <!-- NOVA SEÇÃO DE CONTATO - FOCO NO WHATSAPP -->
    <section id="contato" class="w-full py-16 md:py-24 bg-gradient-to-tr from-green-600 to-emerald-800">
        <div class="max-w-3xl mx-auto px-6 flex flex-col items-center text-center">
            <span class="icon-[mdi--whatsapp] text-7xl text-white mb-4"></span>
            <h2 class="text-4xl md:text-5xl font-extrabold text-white text-balance tracking-tight">
                Precisa de ajuda agora?
            </h2>
            <p class="mt-4 text-lg md:text-xl text-green-100 max-w-xl">
                Sem formulários, sem espera. Clique no botão abaixo para falar diretamente comigo no WhatsApp e resolver seu problema de forma rápida.
            </p>
            <a
                    href={`https://wa.me/${whatsapp}?text=Olá! Vi seu site e gostaria de um orçamento.`}
                    target="_blank"
                    rel="noopener"
                    class="mt-8 inline-flex items-center gap-3 bg-white hover:bg-green-50 text-green-700 font-bold px-8 py-4 rounded-full shadow-lg transition-transform hover:scale-105"
            >
                <span class="icon-[mdi--whatsapp] w-8 h-8"></span>
                <span class="text-xl">{telefone}</span>
            </a>
            <!--<p class="mt-6 text-sm text-green-200">-->
            <!--    Atendimento de Segunda a Sábado, das 8h às 18h.-->
            <!--</p>-->
        </div>
    </section>


</main>
<Footer/>

</body>
</html>